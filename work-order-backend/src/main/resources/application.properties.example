spring.application.name=repair-system

# Multipart 上傳（附件），沒設定時 Spring Boot 預設只有 1MB
spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=15MB

#JWT token expire time (minutes)
jwt.token.expire=10
# HS512 至少需要 64 bytes；正式環境請由環境變數提供，不要提交真實密鑰
jwt.token.secret=${JWT_TOKEN_SECRET}

#JSON
spring.jackson.date-format=yyyy-MM-dd
spring.jackson.time-zone=Asia/Taipei

# JPA
spring.jpa.database-platform=org.hibernate.dialect.SQLServerDialect
spring.jpa.show-sql=true
spring.jpa.hibernate.ddl-auto=update
spring.jpa.hibernate.naming.implicit-strategy=org.hibernate.boot.model.naming.ImplicitNamingStrategyLegacyJpaImpl
spring.jpa.hibernate.naming.physical-strategy=org.hibernate.boot.model.naming.PhysicalNamingStrategyStandardImpl

# database connection info
spring.datasource.driver-class-name=com.microsoft.sqlserver.jdbc.SQLServerDriver
spring.datasource.url=jdbc:sqlserver://localhost:1433;encrypt=true;trustServerCertificate=true;database=workorderDB;
spring.datasource.username=YOUR_USERNAME
spring.datasource.password=YOUR_PASSWORD

# JWT access token expire time (minutes)
jwt.token.expire=10

# OAuth2 & Frontend URLs
spring.security.oauth2.client.registration.google.redirect-uri=${GOOGLE_REDIRECT_URI:http://localhost:8080/login/oauth2/code/google}
app.frontend-url=${FRONTEND_URL:http://localhost:5173}
app.cors.allowed-origin-patterns=${CORS_ALLOWED_ORIGINS:http://localhost:*,http://127.0.0.1:*}
app.password-reset-url=${PASSWORD_RESET_URL:http://localhost:5173/reset-password}

# Refresh token expire time (days)
refresh.token.expire-days=7
# Local development uses HTTP
refresh.cookie.secure=false

# Mail configuration
spring.mail.host=${MAIL_HOST:smtp.gmail.com}
spring.mail.port=${MAIL_PORT:587}
spring.mail.username=${MAIL_USERNAME:noreply@example.com}
spring.mail.password=${MAIL_PASSWORD:password}
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true
