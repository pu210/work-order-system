# 複製這份成 .env（.env 不會進版控），自己填真實密碼
# SA 密碼要符合 MSSQL 強度要求：至少 8 碼，且包含大寫、小寫、數字、符號其中 3 種
DB_SA_PASSWORD=Your_password123!

# 對外開放的 port，本機電腦如果剛好被別的程式佔用（例如你自己另外裝過 MSSQL），
# 改這個數字就好，不用改 docker-compose.yml；不設的話預設用 1433
DB_PORT=1433

# ---------------------------------------------------------------------------
# backend
# ---------------------------------------------------------------------------

# 【必填】JWT 簽章密鑰，HS512 演算法要求至少 64 bytes（等於至少 64 個字元），
# 太短後端會直接啟動失敗。可以用這行指令產生一組隨機的：
#   openssl rand -base64 64 | tr -d '\n'
JWT_TOKEN_SECRET=

# 【必填，但可以先填假的】Google 登入用的 OAuth2 client id/secret。
# Spring Security 在應用程式「啟動當下」就會驗證這兩個值不能是空字串，
# 沒有真的要測 Google 登入的話，先填假值撐過啟動檢查即可，例如：
GOOGLE_CLIENT_ID=fake-client-id
GOOGLE_CLIENT_SECRET=fake-client-secret

# 以下都有預設值，不設也能跑，先不用理，除非有特別需求才調整
BACKEND_PORT=8080
JWT_TOKEN_EXPIRE=10
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_COOKIE_SECURE=false
# 注意：這個是給後端寄信/OAuth2 導向用的「使用者看到的前端網址」，
# Docker 化後前端走 nginx + HTTPS（預設 443 port），不是 vite dev server 的 5173，
# 如果改了 FRONTEND_HTTPS_PORT，這裡也要跟著改成一樣的 port
FRONTEND_URL=https://localhost
# 要同時列出 http/https，瀏覽器帶的 Origin 是 https://localhost（我們有做 HTTPS），
# 只允許 http 會被 Spring Security 的 CORS 檢查擋掉，回 403 Invalid CORS request。
# 帶 port 號的 :* 寫法跟「不帶 port」都要列，因為瀏覽器對預設 port（443/80）發請求時，
# Origin header 不會帶 port 號，只寫 https://localhost:* 這種形式反而比對不到
CORS_ALLOWED_ORIGINS=https://localhost,https://localhost:*,http://localhost,http://localhost:*,https://127.0.0.1,https://127.0.0.1:*,http://127.0.0.1,http://127.0.0.1:*
GOOGLE_REDIRECT_URI=http://localhost:8080/login/oauth2/code/google
# 沒有要測「忘記密碼寄信」功能可以留空，寄信失敗只會在那個功能被呼叫時才報錯，不影響啟動
MAIL_USERNAME=
MAIL_PASSWORD=

# ---------------------------------------------------------------------------
# frontend
# ---------------------------------------------------------------------------
FRONTEND_PORT=80
FRONTEND_HTTPS_PORT=443
